# Postgres connection
DATABASE_URL=postgresql://agenttrust:agenttrust@localhost:5432/agenttrust

# The site being monitored (used for scoping + CORS on the capture endpoint)
SITE_ORIGIN=https://unitedcellars.com.au

# Shopify (for the orders/outcomes join — fill in once the pilot is greenlit)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=

# Cloudflare (optional free signal — leave blank if the site isn't behind Cloudflare)
CF_BOT_HEADER_NAME=cf-bot-category
