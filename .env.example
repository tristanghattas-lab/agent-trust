# Postgres connection
DATABASE_URL=postgresql://agenttrust:agenttrust@localhost:5432/agenttrust

# The site being monitored (used for scoping + CORS on the capture endpoint)
# Local testing target: the Shopify dev store. Switch to the real domain
# (e.g. unitedcellars.com.au) once testing moves there.
SITE_ORIGIN=https://icelabs-bdy57pfy.myshopify.com

# Shopify (for the orders/outcomes join)
SHOPIFY_STORE_DOMAIN=icelabs-bdy57pfy.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=
# From Settings -> Notifications -> Webhooks when you create the orders/create
# webhook (Shopify shows the signing secret once, at creation time).
SHOPIFY_WEBHOOK_SECRET=

# Cloudflare (optional free signal — leave blank if the site isn't behind Cloudflare)
CF_BOT_HEADER_NAME=cf-bot-category
